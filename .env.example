# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini
GENERATION_MODEL_NAME=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Database (Qdrant Cloud)
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io
QDRANT_COLLECTION_NAME=cosmetic_ad_rules_v2
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# BM25 Sparse Index File Path
BM25_INDEX_PATH=data/02_processed/bm25_index.pkl

# Judge Backend (rule | gpt)
JUDGE_BACKEND=rule

# Ops & Observability
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cosmetic-ad-agent

# API Server
API_HOST=0.0.0.0
API_PORT=8000
# Django uses AI_API_URL in web/.env (http://api:8000 inside Docker Compose).
# Keep the existing Qdrant Cloud URL, key, collection and embedding model above.

# 공공데이터포털 (화장품 원료성분정보 등) - Decoding 키
DATA_GO_KR_API_KEY=
