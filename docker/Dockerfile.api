FROM python:3.12-slim

WORKDIR /app

# Install the committed, pinned runtime dependencies before copying app code.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && useradd --create-home --uid 10001 appuser

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src:/app \
    PROJECT_ROOT=/app

# Both generation and retrieval read reference files directly from data/.
# .dockerignore excludes local pickle indexes; always rebuild from tracked chunks.
COPY --chown=appuser:appuser src ./src
COPY --chown=appuser:appuser configs ./configs
COPY --chown=appuser:appuser data ./data
COPY --chown=appuser:appuser api ./api
COPY --chown=appuser:appuser indexing/05_build_indexes.py indexing/metadata_enrichment.py ./indexing/
COPY --chown=appuser:appuser scripts/check_connections.py ./scripts/check_connections.py

USER appuser

# Build only BM25: no API keys, embedding requests, or Qdrant writes at build time.
RUN PYTHONPATH=/app/indexing python -c "import runpy; m = runpy.run_path('indexing/05_build_indexes.py'); m['build_bm25_index'](m['load_chunks'](), m['DEFAULT_BM25_PATH'])"

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3).close()"]

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
