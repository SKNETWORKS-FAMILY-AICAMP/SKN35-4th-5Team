# Copy to web/.env on EC2. Do not overwrite an existing file.
# Root .env remains the OpenAI/Qdrant configuration for the FastAPI container.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
DJANGO_HTTPS=False

# MySQL database must exist before running manage.py migrate.
# URL-encode special characters in the username/password (e.g. @ -> %40).
DATABASE_URL=mysql://beaurette_app:CHANGE_ME@YOUR_RDS_ENDPOINT:3306/beaurette
# The Docker image contains this AWS CA bundle. MySQL uses VERIFY_IDENTITY.
DATABASE_SSL_ROOT_CERT=/app/certs/rds-global-bundle.pem

AI_API_URL=http://api:8000
AI_API_TIMEOUT=180

# Initial check through an SSH tunnel, not a public HTTP login form.
# For launch: set your real domain, WEB_BIND_IP=0.0.0.0, DJANGO_HTTPS=True,
# DJANGO_ALLOWED_HOSTS=your-domain,localhost,127.0.0.1 and
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.
SITE_ADDRESS=http://localhost
WEB_BIND_IP=127.0.0.1
