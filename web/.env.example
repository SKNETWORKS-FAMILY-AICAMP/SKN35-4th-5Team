# 로컬 개발용 Django 환경변수 (web/.env 로 복사해서 사용)
# EC2/RDS 배포용 예제는 docker/web.env.example 및 docker/README.django.md 참고.

# 운영에서는 False, 그리고 SECRET_KEY 필수
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
# 쉼표로 구분. 운영 예: 13.125.x.x,beaurette.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 운영 예: http://13.125.x.x,https://beaurette.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# HTTPS 적용 후 True (보안 쿠키)
DJANGO_HTTPS=False

# DEBUG=True에서 비워두면 web/db.sqlite3 사용. 운영은 RDS MySQL 권장(PostgreSQL도 지원).
DATABASE_URL=

# FastAPI AI 서버 (3차 엔진). docker-compose 안에서는 http://api:8000
AI_API_URL=http://localhost:8000
AI_API_TIMEOUT=180
